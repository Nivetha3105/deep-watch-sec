# SentinelIDS Backend Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/network_intrusion
REDIS_URL=redis://localhost:6379

# Notification Filtering & Rate Limiting
# Minimum severity required to trigger external alerts: HIGH, MEDIUM, LOW
NOTIFICATION_MIN_SEVERITY=HIGH
# Cooldown window per (attack_type + source_ip) in seconds (default: 300s / 5 mins)
NOTIFICATION_COOLDOWN_SECONDS=300

# Discord Webhook Integration (Optional, disabled if left empty)
# Example: https://discord.com/api/webhooks/1234567890/abcdefghijklmnopqrstuvwxyz
DISCORD_WEBHOOK_URL=

# Telegram Bot Integration (Optional, disabled if left empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email / SMTP Integration via Nodemailer (Optional, disabled if left empty)
# Example for Mailtrap / local dev: host=sandbox.smtp.mailtrap.io port=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=alerts@sentinelids.local
NOTIFICATION_EMAIL_TO=soc-analysts@sentinelids.local
